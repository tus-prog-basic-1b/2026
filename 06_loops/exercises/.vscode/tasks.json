{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build current C file",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "mkdir -p \"${workspaceFolder}/build\" && gcc -std=c11 -Wall -Wextra -pedantic -g \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
